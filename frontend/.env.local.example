VITE_API_BASE_URL=http://localhost:9001

# Google Maps JavaScript API browser key (HTTP-referrer restricted). Required for
# the embedded Google Maps (Fleet Map, route planner, address pickers, parent
# tracking). Create one in Google Cloud → APIs & Services → Credentials and
# enable: Maps JavaScript API, Places API, Geocoding API, Maps Embed API.
# Production builds take the restricted key from SSM
# /saferide/google-maps-browser-key instead (infra/scripts/deploy-frontend.sh).
VITE_GOOGLE_MAPS_API_KEY=

# Google Maps Map ID (mandatory for AdvancedMarker). Leave it unset for
# development: the app falls back to Google's demo Map ID below. Production
# builds take the Cloud-styled Map ID from SSM /saferide/google-maps-map-id.
# VITE_GOOGLE_MAPS_MAP_ID=4504f8b37365c3d0
